# Backend environment variables (do not commit real secrets)

# If provided, should be a PostgreSQL URL/DSN. Examples:
# POSTGRES_URL=postgresql+psycopg://user:password@localhost:5000/mydb
# POSTGRES_URL=postgresql://user:password@localhost:5000/mydb
POSTGRES_URL=

# Alternative (if POSTGRES_URL not provided)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# JWT signing
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
